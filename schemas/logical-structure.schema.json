{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-modeller.local/schemas/logical-structure.schema.json",
  "title": "System Modeller logical structure model",
  "description": "Model through Plan A step A10 including Subsystem, Component and Service.",
  "$defs": {
    "system": {
      "$ref": "https://system-modeller.local/schemas/context.schema.json#/$defs/system"
    },
    "externalSystem": {
      "$ref": "https://system-modeller.local/schemas/context.schema.json#/$defs/externalSystem"
    },
    "actor": {
      "$ref": "https://system-modeller.local/schemas/context.schema.json#/$defs/actor"
    },
    "responsibility": {
      "$ref": "https://system-modeller.local/schemas/functions.schema.json#/$defs/responsibility"
    },
    "useCase": {
      "$ref": "https://system-modeller.local/schemas/use-cases.schema.json#/$defs/useCase"
    },
    "informationObject": {
      "$ref": "https://system-modeller.local/schemas/information.schema.json#/$defs/informationObject"
    },
    "subsystem": {
      "allOf": [
        {
          "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/modelElement"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^SUB-[0-9]{6}$"
            },
            "type": {
              "const": "Subsystem"
            },
            "abstraction_level": {
              "const": "logical"
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "component": {
      "allOf": [
        {
          "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/modelElement"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^CMP-[0-9]{6}$"
            },
            "type": {
              "const": "Component"
            },
            "abstraction_level": {
              "const": "logical"
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "service": {
      "allOf": [
        {
          "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/modelElement"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^SVC-[0-9]{6}$"
            },
            "type": {
              "const": "Service"
            },
            "abstraction_level": {
              "const": "logical"
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "logicalRelationship": {
      "allOf": [
        {
          "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/relationship"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "interacts_with",
                "uses",
                "exchanges_information_with",
                "has_responsibility",
                "performs",
                "groups_use_case",
                "includes",
                "extends",
                "specializes",
                "contains_information",
                "references_information",
                "relates_to_information",
                "derived_from_information",
                "creates_information",
                "reads_information",
                "updates_information",
                "deletes_information",
                "owns_information",
                "masters_information",
                "stores_information",
                "exchanges_information",
                "contains",
                "part_of",
                "depends_on",
                "provides",
                "realized_by",
                "realizes"
              ]
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "elements",
    "relationships"
  ],
  "properties": {
    "elements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/system"
          },
          {
            "$ref": "#/$defs/externalSystem"
          },
          {
            "$ref": "#/$defs/actor"
          },
          {
            "$ref": "#/$defs/responsibility"
          },
          {
            "$ref": "#/$defs/useCase"
          },
          {
            "$ref": "#/$defs/informationObject"
          },
          {
            "$ref": "#/$defs/subsystem"
          },
          {
            "$ref": "#/$defs/component"
          },
          {
            "$ref": "#/$defs/service"
          }
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/logicalRelationship"
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "elements": {
          "contains": {
            "$ref": "#/$defs/system"
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  ],
  "additionalProperties": false
}
