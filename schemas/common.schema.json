{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-modeller.local/schemas/common.schema.json",
  "title": "System Modeller common model base",
  "description": "Reusable base definitions introduced in Plan A step A4 and refined through A22.",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9]{6}$"
    },
    "typeName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$",
      "minLength": 1
    },
    "relationshipType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "minLength": 1
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "abstractionLevel": {
      "type": "string",
      "enum": [
        "conceptual",
        "logical",
        "runtime",
        "implementation"
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "idReferenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "modelElement": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "abstraction_level"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "type": {
          "$ref": "#/$defs/typeName"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "abstraction_level": {
          "$ref": "#/$defs/abstractionLevel"
        },
        "status": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "aliases": {
          "$ref": "#/$defs/stringList"
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        },
        "origin": {
          "$ref": "#/$defs/originList"
        },
        "evidence": {
          "$ref": "#/$defs/idReferenceList"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REL-[0-9]{6}$"
        },
        "type": {
          "$ref": "#/$defs/relationshipType"
        },
        "source": {
          "$ref": "#/$defs/stableId"
        },
        "target": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "abstraction_level": {
          "$ref": "#/$defs/abstractionLevel"
        },
        "status": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        },
        "origin": {
          "$ref": "#/$defs/originList"
        },
        "evidence": {
          "$ref": "#/$defs/idReferenceList"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "originKind": {
      "type": "string",
      "enum": [
        "declared",
        "observed",
        "inferred",
        "user_confirmed",
        "unresolved"
      ]
    },
    "originList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/originKind"
      },
      "uniqueItems": true,
      "minItems": 1
    }
  }
}
