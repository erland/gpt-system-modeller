{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-modeller.local/schemas/provenance.schema.json",
  "title": "System Modeller model with provenance and evidence",
  "description": "Model through Plan A step A21 including Source, SourceReference and Evidence provenance records.",
  "$defs": {
    "system": {
      "$ref": "https://system-modeller.local/schemas/context.schema.json#/$defs/system"
    },
    "externalSystem": {
      "$ref": "https://system-modeller.local/schemas/context.schema.json#/$defs/externalSystem"
    },
    "actor": {
      "$ref": "https://system-modeller.local/schemas/context.schema.json#/$defs/actor"
    },
    "responsibility": {
      "$ref": "https://system-modeller.local/schemas/functions.schema.json#/$defs/responsibility"
    },
    "useCase": {
      "$ref": "https://system-modeller.local/schemas/use-cases.schema.json#/$defs/useCase"
    },
    "informationObject": {
      "$ref": "https://system-modeller.local/schemas/information.schema.json#/$defs/informationObject"
    },
    "subsystem": {
      "$ref": "https://system-modeller.local/schemas/logical-structure.schema.json#/$defs/subsystem"
    },
    "component": {
      "$ref": "https://system-modeller.local/schemas/logical-structure.schema.json#/$defs/component"
    },
    "service": {
      "$ref": "https://system-modeller.local/schemas/logical-structure.schema.json#/$defs/service"
    },
    "interface": {
      "$ref": "https://system-modeller.local/schemas/interfaces.schema.json#/$defs/interface"
    },
    "api": {
      "$ref": "https://system-modeller.local/schemas/interfaces.schema.json#/$defs/api"
    },
    "message": {
      "$ref": "https://system-modeller.local/schemas/messaging.schema.json#/$defs/message"
    },
    "event": {
      "$ref": "https://system-modeller.local/schemas/messaging.schema.json#/$defs/event"
    },
    "dataStore": {
      "$ref": "https://system-modeller.local/schemas/data-stores.schema.json#/$defs/dataStore"
    },
    "scenario": {
      "$ref": "https://system-modeller.local/schemas/scenarios.schema.json#/$defs/scenario"
    },
    "interaction": {
      "$ref": "https://system-modeller.local/schemas/interactions.schema.json#/$defs/interaction"
    },
    "runtimeUnit": {
      "$ref": "https://system-modeller.local/schemas/runtime.schema.json#/$defs/runtimeUnit"
    },
    "environment": {
      "allOf": [
        {
          "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/modelElement"
        },
        {
          "type": "object",
          "required": [
            "environment_kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^ENV-[0-9]{6}$"
            },
            "type": {
              "const": "Environment"
            },
            "abstraction_level": {
              "const": "runtime"
            },
            "environment_kind": {
              "type": "string",
              "enum": [
                "development",
                "test",
                "staging",
                "production",
                "other"
              ]
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "deploymentNode": {
      "allOf": [
        {
          "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/modelElement"
        },
        {
          "type": "object",
          "required": [
            "node_kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^NODE-[0-9]{6}$"
            },
            "type": {
              "const": "DeploymentNode"
            },
            "abstraction_level": {
              "const": "runtime"
            },
            "node_kind": {
              "type": "string",
              "enum": [
                "client_device",
                "server",
                "virtual_machine",
                "container_platform",
                "cloud_service",
                "database_platform",
                "external_platform"
              ]
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "technology": {
              "type": "string",
              "minLength": 1
            },
            "location_hint": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "deploymentRelationship": {
      "allOf": [
        {
          "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/relationship"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "realized_as",
                "deployed_on",
                "belongs_to",
                "connects_to"
              ]
            },
            "protocol": {
              "type": "string",
              "minLength": 1
            },
            "direction": {
              "type": "string",
              "enum": [
                "source_to_target",
                "bidirectional"
              ]
            },
            "encryption": {
              "type": "string",
              "minLength": 1
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "exchanged_information": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^INFO-[0-9]{6}$"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "connects_to"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {},
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "protocol"
                      ]
                    },
                    {
                      "required": [
                        "direction"
                      ]
                    },
                    {
                      "required": [
                        "encryption"
                      ]
                    },
                    {
                      "required": [
                        "purpose"
                      ]
                    },
                    {
                      "required": [
                        "exchanged_information"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "architectureDecision": {
      "allOf": [
        {
          "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/modelElement"
        },
        {
          "type": "object",
          "required": [
            "decision_status",
            "context",
            "decision",
            "rationale"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^ADR-[0-9]{6}$"
            },
            "type": {
              "const": "ArchitectureDecision"
            },
            "abstraction_level": {
              "const": "conceptual"
            },
            "decision_status": {
              "type": "string",
              "enum": [
                "proposed",
                "accepted",
                "deprecated",
                "superseded",
                "rejected"
              ]
            },
            "context": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "consequences": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "affected_elements": {
              "type": "array",
              "items": {
                "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/stableId"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "constraint": {
      "allOf": [
        {
          "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/modelElement"
        },
        {
          "type": "object",
          "required": [
            "statement"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^CON-[0-9]{6}$"
            },
            "type": {
              "const": "Constraint"
            },
            "abstraction_level": {
              "const": "conceptual"
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "constraint_kind": {
              "type": "string",
              "enum": [
                "business",
                "regulatory",
                "organizational",
                "technical",
                "security",
                "operational",
                "other"
              ]
            },
            "affected_elements": {
              "type": "array",
              "items": {
                "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/stableId"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "decisionRelationship": {
      "allOf": [
        {
          "$ref": "https://system-modeller.local/schemas/common.schema.json#/$defs/relationship"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "affects"
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "source_kind",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-[0-9]{6}$"
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "source_code",
            "documentation",
            "user_statement",
            "api_specification",
            "database_schema",
            "configuration",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "type": {
          "const": "Source"
        }
      },
      "additionalProperties": false
    },
    "sourceReference": {
      "type": "object",
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REF-[0-9]{6}$"
        },
        "source": {
          "type": "string",
          "pattern": "^SRC-[0-9]{6}$"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "paragraph": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "excerpt_hash": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "type": {
          "const": "SourceReference"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "start_line",
              "end_line"
            ]
          },
          "then": {
            "properties": {
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "evidenceRecord": {
      "type": "object",
      "required": [
        "id",
        "status",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EVD-[0-9]{6}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "source_confirmed",
            "user_confirmed",
            "inferred",
            "assumed",
            "unresolved"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^REF-[0-9]{6}$"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "type": {
          "const": "Evidence"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "inferred",
                  "assumed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "source_confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "source_refs"
            ],
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "elements",
    "relationships"
  ],
  "properties": {
    "elements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/system"
          },
          {
            "$ref": "#/$defs/externalSystem"
          },
          {
            "$ref": "#/$defs/actor"
          },
          {
            "$ref": "#/$defs/responsibility"
          },
          {
            "$ref": "#/$defs/useCase"
          },
          {
            "$ref": "#/$defs/informationObject"
          },
          {
            "$ref": "#/$defs/subsystem"
          },
          {
            "$ref": "#/$defs/component"
          },
          {
            "$ref": "#/$defs/service"
          },
          {
            "$ref": "#/$defs/interface"
          },
          {
            "$ref": "#/$defs/api"
          },
          {
            "$ref": "#/$defs/message"
          },
          {
            "$ref": "#/$defs/event"
          },
          {
            "$ref": "#/$defs/dataStore"
          },
          {
            "$ref": "#/$defs/scenario"
          },
          {
            "$ref": "#/$defs/interaction"
          },
          {
            "$ref": "#/$defs/runtimeUnit"
          },
          {
            "$ref": "#/$defs/environment"
          },
          {
            "$ref": "#/$defs/deploymentNode"
          },
          {
            "$ref": "#/$defs/architectureDecision"
          },
          {
            "$ref": "#/$defs/constraint"
          }
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decisionRelationship"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "source_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceReference"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceRecord"
      }
    }
  },
  "additionalProperties": false
}
