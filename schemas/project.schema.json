{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-modeller.local/schemas/project.schema.json",
  "title": "System Modeller system project manifest",
  "description": "Validates project.yaml for a portable System Modeller system project (A23).",
  "type": "object",
  "required": [
    "format",
    "project"
  ],
  "properties": {
    "format": {
      "const": "system-modeller-project"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "schema_version",
        "model_version",
        "language"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "model_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "default_view_profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:[a-z0-9])?$"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
